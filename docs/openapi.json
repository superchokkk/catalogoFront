  "info": {
    "title": "API do Catálogo",
    "description": "API de catálogo de produtos (NestJS + Supabase). A autenticação é por cookie httpOnly `access_token`, gravado por `POST /auth/login`. Rotas que alteram dados só aceitam requisições vindas de origens autorizadas (FRONTEND_URL / CORS_ORIGINS).",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@exemplo.com",
            "maxLength": 100
          },
          "senha": {
            "type": "string",
            "example": "minha-senha-123",
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "senha"
        ]
      },
      "RespostaSucessoDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operação realizada com sucesso."
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "RespostaErroDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "statusCode": {
            "type": "number",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Descrição do erro.",
            "description": "Texto, ou lista de textos (um por campo) nos erros de validação."
          },
          "error": {
            "type": "string",
            "example": "Bad Request",
            "description": "Nome HTTP do status."
          }
        },
        "required": [
          "success",
          "statusCode",
          "message"
        ]
      },
      "EsqueciSenhaDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@exemplo.com",
            "maxLength": 100
          }
        },
        "required": [
          "email"
        ]
      },
      "RedefinirSenhaDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@exemplo.com"
          },
          "token": {
            "type": "string",
            "description": "Código (OTP) de 6 a 10 dígitos enviado por e-mail.",
            "example": "123456"
          },
          "novaSenha": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "email",
          "token",
          "novaSenha"
        ]
      },
      "SetSessionDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Access token (JWT) emitido pelo Supabase."
          },
          "refresh_token": {
            "type": "string",
            "description": "Se enviado, a sessão passa a poder ser renovada em /auth/refresh.",
            "maxLength": 512
          }
        },
        "required": [
          "access_token"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Cadeira Gamer",
            "minLength": 1,
            "maxLength": 200
          },
          "descricao": {
            "type": "string",
            "maxLength": 5000
          },
          "preco": {
            "type": "string",
            "example": "1.299,90",
            "description": "Número ou texto no formato BR/US. Entre 0 e 10.000.000."
          }
        },
